# 飞桨 AI Studio Access Token（支持多个，换行或逗号分隔）
# 获取：https://aistudio.baidu.com/account/accessToken
# Railway 上请在 Variables 配置同名变量，不要提交真实 Token
PADDLEOCR_ACCESS_TOKENS=
# 兼容旧单 Token 变量
PADDLEOCR_ACCESS_TOKEN=

# 服务绑定（Railway 会注入 PORT）
HOST=0.0.0.0
PORT=8787

# 批量解析并发数（1-8；Railway 省钱建议 1）
CONCURRENCY=2

# 省钱模式：禁用默认 SSE、可配合跳过预拉图片（Railway 默认开启）
# ECONOMY_MODE=1
# SKIP_IMAGE_PREFETCH=1

# 公网根地址（Railway 会自动有 RAILWAY_PUBLIC_DOMAIN；用于官方 API 回拉文件）
# PUBLIC_BASE_URL=https://your-app.up.railway.app

# 本机中继：npm run relay 会自动打开；强制直传百度、允许云端页跨域
# RELAY_MODE=1
