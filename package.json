{
  "name": "ocr_pdf2md",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local web UI: PDF/image → Markdown via PaddleOCR official API",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "relay": "RELAY_MODE=1 ECONOMY_MODE=0 SKIP_IMAGE_PREFETCH=0 tsx server/index.ts"
  },
  "dependencies": {
    "@paddleocr/api-sdk": "^0.2.3",
    "archiver": "^8.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "tsx": "^4.23.11"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
